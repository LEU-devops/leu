JWT_SECRET=
JWT_EXPIRES_IN=1d

# "production" uses Turso through LIBSQL_URL/LIBSQL_AUTH_TOKEN; anything else uses a local better-sqlite3 file.
NODE_ENV=dev

# Development (optional, defaults to ./data/dev.sqlite3)
SQLITE_FILE=./data/dev.sqlite3

# Production (Turso)
LIBSQL_URL=libsql://your-db-name.turso.io
LIBSQL_AUTH_TOKEN=
